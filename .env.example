# ---- Core ----
# Local dev uses SQLite. For production use Postgres (see README) and change
# the provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"
# Public URL of this app (used in emails and Stripe redirects)
APP_URL="http://localhost:3000"
# Long random string used to sign admin sessions: `openssl rand -hex 32`
SESSION_SECRET="change-me-to-a-long-random-string"
# Business timezone - all times shown to customers/staff use this
BUSINESS_TZ="America/Chicago"

# ---- First admin account (created by `npm run db:seed`) ----
ADMIN_EMAIL="admin@portaboatrentals.com"
ADMIN_PASSWORD="change-me"

# ---- Stripe ----
# Leave blank to run in MOCK PAYMENT mode (no real charges; great for testing).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---- Photo storage ----
# "local" stores files in ./uploads (dev only). "s3" works with AWS S3,
# Cloudflare R2, Backblaze B2, DigitalOcean Spaces, etc.
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---- Email (optional) ----
# Leave SMTP_HOST blank to just log emails to the console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Port A Boat Rentals <bookings@portaboatrentals.com>"
STAFF_NOTIFY_EMAIL=""

# Secret for the scheduled job endpoint GET /api/cron
CRON_SECRET="change-me-too"

# ---- Guest texting through Quo (formerly OpenPhone) ----
# Leave blank for test mode (texts are saved in the app but not sent).
# API key: Quo → Settings → API. Phone number ID starts with "PN".
QUO_API_KEY=""
QUO_PHONE_NUMBER_ID=""
# Signing key ("whsec_...") returned when you create the Quo webhook pointing at /api/quo/webhook
QUO_WEBHOOK_SECRET=""

# ---- Automatic photo damage check (Claude) ----
# Leave blank to turn off; dock crew then log damage by hand.
ANTHROPIC_API_KEY=""

# ---- Online reviews (optional) ----
# Leave blank and the Reviews page shows "Not connected" (you can still type ratings in by hand).
# Google: Google Cloud → enable "Places API (New)" → create an API key. Set the Place ID on Admin → Reviews.
GOOGLE_PLACES_API_KEY=""
# Facebook: a Page access token with pages_read_engagement + pages_read_user_content. Set the Page ID on Admin → Reviews.
FACEBOOK_PAGE_ACCESS_TOKEN=""

# ---- Xero (expenses for profit & breakeven; read-only) ----
# Leave blank for test mode (type in or CSV-import expenses instead).
# developer.xero.com → My Apps → New app (Web app). Redirect URI: <APP_URL>/api/xero/callback
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
# Optional override. Default: offline_access accounting.banktransactions.read accounting.invoices.read accounting.settings.read
XERO_SCOPES=""
