# ---- Core ----
# Local dev uses SQLite. For production use Postgres (see README) and change
# the provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"
# Public URL of this app (used in emails and Stripe redirects)
APP_URL="http://localhost:3000"
# Long random string used to sign admin sessions: `openssl rand -hex 32`
SESSION_SECRET="change-me-to-a-long-random-string"
# Business timezone - all times shown to customers/staff use this
BUSINESS_TZ="America/Chicago"

# ---- First admin account (created by `npm run db:seed`) ----
ADMIN_EMAIL="admin@portaboatrentals.com"
ADMIN_PASSWORD="change-me"

# ---- Stripe ----
# Leave blank to run in MOCK PAYMENT mode (no real charges; great for testing).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---- Photo storage ----
# "local" stores files in ./uploads (dev only). "s3" works with AWS S3,
# Cloudflare R2, Backblaze B2, DigitalOcean Spaces, etc.
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---- Email (optional) ----
# Leave SMTP_HOST blank to just log emails to the console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Port A Boat Rentals <bookings@portaboatrentals.com>"
STAFF_NOTIFY_EMAIL=""

# Secret for the scheduled job endpoint GET /api/cron
CRON_SECRET="change-me-too"
