// Port A Boat Rentals - booking & operations database
//
// Local development uses SQLite. For production switch `provider` to
// "postgresql" and point DATABASE_URL at your Postgres database.
// Status-like fields are plain strings (see src/lib/constants.ts) so the
// schema works identically on SQLite and Postgres.
// All money is stored in integer cents.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  // owner (Admin) | manager | accounting | staff (Office) | dock (Crew)
  role         String   @default("staff")
  active       Boolean  @default(true)
  phone        String   @default("")
  // Payroll
  hourlyRateCents Int   @default(0)
  gustoEmployeeId String?
  color        String   @default("#1E6286")
  createdAt    DateTime @default(now())
  shifts       Shift[]
  timeEntries  TimeEntry[]
  timeOff      TimeOffRequest[]
  bookingCrew  BookingCrew[]
}

// ---------- Inventory ----------

model Boat {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  type           String   @default("Tritoon")
  description    String   @default("")
  capacity       Int      @default(10)
  lengthFt       Int?
  horsepower     Int?
  imageUrl       String?
  depositCents   Int      @default(50000)
  // available | maintenance | retired
  status         String   @default("available")
  sortOrder      Int      @default(0)
  // Operational tracking
  engineHours    Float    @default(0)
  registration   String?  // TX registration number
  hullId         String?  // HIN
  notes          String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rates          Rate[]
  bookings       Booking[]
  blocks         BoatBlock[]
  // On-water towing / assistance (TowBoatUS, Sea Tow, local)
  towCompany      String   @default("")
  towPhone        String   @default("")
  towMemberNumber String   @default("")
  towPlan         String   @default("")
  towExpiresAt    DateTime?
  towNotes        String   @default("")

  maintenance    MaintenanceLog[]
  schedules      MaintenanceSchedule[]
  damage         DamageReport[]
  insurance      InsurancePolicy[]
  costs          BoatCost[]
  expenses       Expense[]
  incidents      Incident[]
  budgets        Budget[]
}

// A bookable duration and its price, e.g. "Half Day (4 hrs)" $450
model Rate {
  id          String  @id @default(cuid())
  boatId      String
  boat        Boat    @relation(fields: [boatId], references: [id], onDelete: Cascade)
  label       String
  minutes     Int
  priceCents  Int
  // Optional weekend/holiday price; null = same as priceCents
  weekendPriceCents Int?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
  bookings    Booking[]
}

// Optional extras (Mega Chill, paddle boards, coolers, etc.)
model AddOn {
  id          String  @id @default(cuid())
  name        String
  description String  @default("")
  priceCents  Int
  // Total units owned; bookings can't exceed this at any moment
  quantity    Int     @default(1)
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
  bookingAddOns BookingAddOn[]
  maintenance MaintenanceLog[]
}

// ---------- Mandatory fees ----------

// Fees applied to every booking, e.g. Damage Waiver ($50 for 4 hrs, $100 for 9 hrs)
// or Fuel (included in the boat price, shown as its own line).
model Fee {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  // added = charged on top of the rental | included = part of the rental price, shown separately
  mode        String   @default("added")
  // flat = amount by trip length (tiers) | percent = percent of rental price
  calc        String   @default("flat")
  percentBps  Int      @default(0)
  taxable     Boolean  @default(false)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  tiers       FeeTier[]
}

// "Trips of at least minMinutes cost amountCents." The largest matching tier wins.
model FeeTier {
  id          String @id @default(cuid())
  feeId       String
  fee         Fee    @relation(fields: [feeId], references: [id], onDelete: Cascade)
  minMinutes  Int    @default(0)
  amountCents Int
}

// Fee amounts as charged on a booking (snapshot; later fee edits don't change past bookings)
model BookingFee {
  id          String  @id @default(cuid())
  bookingId   String
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  feeId       String?
  name        String
  mode        String
  amountCents Int
  taxable     Boolean @default(false)
}

// Time a boat can't be booked (maintenance, owner use, weather closures)
model BoatBlock {
  id        String   @id @default(cuid())
  boatId    String?  // null = applies to the whole fleet
  boat      Boat?    @relation(fields: [boatId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  reason    String   @default("")
  createdAt DateTime @default(now())
}

// Service history for a boat or a piece of equipment (add-on)
model MaintenanceLog {
  id          String   @id @default(cuid())
  boatId      String?
  boat        Boat?    @relation(fields: [boatId], references: [id], onDelete: Cascade)
  addOnId     String?
  addOn       AddOn?   @relation(fields: [addOnId], references: [id], onDelete: Cascade)
  scheduleId  String?
  // service | repair | inspection | cleaning | other
  category    String   @default("service")
  performedAt DateTime @default(now())
  engineHours Float?
  description String
  vendor      String   @default("")
  costCents   Int?
  // Optional receipt/photo
  storageKey  String?
  createdBy   String?
  createdAt   DateTime @default(now())
}

// Recurring service, e.g. "Oil change every 100 hrs or 365 days"
model MaintenanceSchedule {
  id            String    @id @default(cuid())
  boatId        String
  boat          Boat      @relation(fields: [boatId], references: [id], onDelete: Cascade)
  name          String
  everyHours    Float?
  everyDays     Int?
  lastDoneAt    DateTime?
  lastDoneHours Float?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

// ---------- Customers & bookings ----------

model Customer {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  email           String   @unique
  phone           String
  stripeCustomerId String?
  notes           String   @default("")
  // CRM
  tags            String   @default("")   // comma separated, e.g. "vip,local,repeat"
  marketingOptIn  Boolean  @default(false) // agreed to promotional texts/emails
  smsOptOut       Boolean  @default(false) // replied STOP
  emailOptOut     Boolean  @default(false)
  unsubToken      String?  @unique
  source          String   @default("")   // how they found us
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  bookings        Booking[]
  messages        Message[]
  campaignSends   CampaignSend[]
}

model Booking {
  id            String   @id @default(cuid())
  // Short human-friendly code customers see, e.g. PA-7K3QX
  code          String   @unique
  // Secret tokens for the customer's manage link and the passenger waiver link
  accessToken   String   @unique
  waiverToken   String   @unique
  boatId        String
  boat          Boat     @relation(fields: [boatId], references: [id])
  rateId        String?
  rate          Rate?    @relation(fields: [rateId], references: [id], onDelete: SetNull)
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])

  startsAt      DateTime
  endsAt        DateTime
  partySize     Int      @default(1)

  // pending (awaiting signature/payment) | confirmed | checked_out | returned | completed | cancelled | no_show
  status        String   @default("pending")
  // Pending bookings hold inventory until this time, then are released
  holdExpiresAt DateTime?
  source        String   @default("online") // online | admin | phone

  // Money (cents)
  subtotalCents Int
  addOnsCents   Int      @default(0)
  taxCents      Int      @default(0)
  // Mandatory fees added on top (see BookingFee for lines)
  feesCents     Int      @default(0)
  // Portion of subtotalCents attributed to included fees (e.g. fuel)
  includedFeesCents Int  @default(0)
  convenienceFeeCents Int @default(0)
  // Tip chosen at booking (included in totalCents; not taxed, no convenience fee)
  tipCents      Int      @default(0)
  totalCents    Int
  paidCents     Int      @default(0)
  refundedCents Int      @default(0)
  // unpaid | paid | partially_refunded | refunded
  paymentStatus String   @default("unpaid")

  // Security deposit
  depositCents          Int      @default(0)
  // none | card_saved | held | released | captured | partially_captured
  depositStatus         String   @default("none")
  depositCapturedCents  Int      @default(0)
  depositHeldAt         DateTime?

  // Stripe references
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  stripePaymentMethodId   String?
  stripeDepositIntentId   String?

  // Operations
  checkedOutAt     DateTime?
  checkedOutBy     String?
  returnedAt       DateTime?
  returnedBy       String?
  fuelOut          String?  // e.g. "Full", "3/4"
  fuelIn           String?
  engineHoursOut   Float?
  engineHoursIn    Float?
  damageNotes      String   @default("")
  internalNotes    String   @default("")
  reminderSentAt   DateTime?
  customerNotes    String   @default("")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  addOns        BookingAddOn[]
  fees          BookingFee[]
  damage        DamageReport[]
  messages      Message[]
  tips          Tip[]
  crew          BookingCrew[]
  incidents     Incident[]
  campaignSends CampaignSend[]
  phoneOrder    PhoneOrder?
  signatures    Signature[]
  photos        Photo[]
  payments      Payment[]
  events        BookingEvent[]

  @@index([boatId, startsAt, endsAt])
  @@index([startsAt])
}

model BookingAddOn {
  id         String  @id @default(cuid())
  bookingId  String
  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addOnId    String
  addOn      AddOn   @relation(fields: [addOnId], references: [id])
  quantity   Int     @default(1)
  priceCents Int     // unit price at time of booking
}

// ---------- Contracts / waivers ----------

model ContractTemplate {
  id        String   @id @default(cuid())
  name      String   // e.g. "Rental Agreement & Liability Waiver"
  version   Int
  body      String   // Markdown-ish plain text
  required  Boolean  @default(true)
  active    Boolean  @default(true)
  // Who must sign: "renter" (primary operator) or "all" (every passenger)
  signer    String   @default("renter")
  createdAt DateTime @default(now())
  signatures Signature[]

  @@unique([name, version])
}

model Signature {
  id           String   @id @default(cuid())
  bookingId    String
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  templateId   String
  template     ContractTemplate @relation(fields: [templateId], references: [id])
  signerName   String
  signerEmail  String?
  // true = the primary renter/operator, false = additional passenger/driver
  isPrimary    Boolean  @default(true)
  dateOfBirth  String?
  // Texas requires boater education for operators born on/after 9/1/1993
  boaterEdNumber String?
  // When a parent/guardian signs on behalf of a minor passenger
  minorName    String?
  minorDob     String?
  guardianRelationship String?
  // PNG data URL of the drawn signature
  signatureData String
  // Exact text the signer agreed to, and its SHA-256 for tamper evidence
  bodySnapshot String
  bodyHash     String
  ipAddress    String?
  userAgent    String?
  signedAt     DateTime @default(now())
}

// ---------- Photos ----------

model Photo {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  // before | after | damage | other
  phase      String
  // Guided shot position: bow | stern | port | starboard | helm | seating | engine | prop | other
  angle      String   @default("other")
  // Automatic damage review: none | pending | done | skipped | error
  aiStatus   String   @default("none")
  aiSummary  String   @default("")
  storageKey String
  contentType String
  sizeBytes  Int
  caption    String   @default("")
  uploadedBy String?
  createdAt  DateTime @default(now())
}

// Damage found by dock crew or flagged by the automatic photo review
model DamageReport {
  id          String   @id @default(cuid())
  boatId      String
  boat        Boat     @relation(fields: [boatId], references: [id], onDelete: Cascade)
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  photoId     String?
  // crew | ai
  source      String   @default("crew")
  // before (existed at check-out) | after (found at check-in)
  phase       String   @default("after")
  angle       String   @default("other")
  location    String   @default("")
  description String
  // minor | moderate | major
  severity    String   @default("minor")
  // needs_check (AI flag awaiting crew) | confirmed | dismissed | repaired
  status      String   @default("confirmed")
  confidence  Float?
  createdBy   String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
}

// ---------- Text messages (Quo) ----------

model Message {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  bookingId  String?
  booking    Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  // in | out
  direction  String
  // Guest phone in E.164, e.g. +13615550123
  phone      String
  body       String
  // queued | sent | delivered | failed | received | mock
  status     String    @default("queued")
  externalId String?   @unique
  error      String?
  sentBy     String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

// ---------- Money ledger ----------

model Payment {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  // charge | refund | deposit_hold | deposit_release | deposit_capture | manual
  kind        String
  amountCents Int
  method      String   @default("card") // card | cash | mock | other
  stripeId    String?
  note        String   @default("")
  createdBy   String?
  createdAt   DateTime @default(now())
}

// Audit trail of everything that happens to a booking
model BookingEvent {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type      String
  message   String
  actor     String?
  createdAt DateTime @default(now())
}

// ---------- Settings (single row) ----------

model Settings {
  id                 Int     @id @default(1)
  businessName       String  @default("Port A Boat Rentals")
  phone              String  @default("361-339-2628")
  email              String  @default("bookings@portaboatrentals.com")
  address            String  @default("Port Aransas, TX")
  // Daily operating window in local time, "HH:MM"
  openTime           String  @default("08:00")
  closeTime          String  @default("19:00")
  // Start-time granularity in minutes
  slotIntervalMin    Int     @default(30)
  // Turnaround/cleaning time between rentals on the same boat
  bufferMin          Int     @default(30)
  // How far ahead customers can book / minimum notice
  maxAdvanceDays     Int     @default(180)
  minNoticeHours     Int     @default(2)
  // Sales tax in basis points (825 = 8.25%)
  taxRateBps         Int     @default(825)
  // Legacy (replaced by Admin → Fees); kept so existing databases update cleanly
  feeRateBps         Int     @default(0)
  // Card convenience fee on online card payments: percent (bps) + flat cents
  convenienceFeeBps   Int    @default(290)
  convenienceFeeCents Int    @default(30)
  convenienceFeeLabel String @default("Card convenience fee")
  // Phone staff/dock crew are alerted on for AI-flagged damage (optional)
  damageAlertPhone    String @default("")
  // Automatic texts through Quo
  smsOnConfirm        Boolean @default(true)
  smsReminder         Boolean @default(true)
  // Tips
  tipsEnabled         Boolean @default(true)
  tipPercents         String  @default("15,18,20")
  // Reviews
  googlePlaceId       String  @default("")
  facebookPageId      String  @default("")
  googleReviewUrl     String  @default("")
  facebookReviewUrl   String  @default("")
  // Phone (Quo AI) orders: how long a drafted booking holds the boat
  phoneHoldHours      Int     @default(24)
  // Free cancellation if cancelled at least this many hours before start
  cancelWindowHours  Int     @default(48)
  // Minutes a pending (unpaid) booking holds the boat
  holdMinutes        Int     @default(20)
  // Weekend days for weekend pricing (0=Sun..6=Sat), comma separated
  weekendDays        String  @default("0,6")
  confirmationNote   String  @default("Please arrive 20 minutes early for your safety briefing. Bring a valid photo ID and the card used to book.")
  updatedAt          DateTime @updatedAt
}


// =====================================================================
// CRM & marketing
// =====================================================================

// An automated message flow (pre-arrival, post-trip, win-back…) or a one-off promotion.
model Campaign {
  id          String   @id @default(cuid())
  name        String
  // automation | broadcast
  kind        String   @default("automation")
  // before_trip | after_trip | after_booking | win_back | manual
  trigger     String   @default("manual")
  // Hours relative to the trigger (before_trip: hours before start; after_trip: hours after end;
  // win_back: days since last trip x 24)
  offsetHours Int      @default(24)
  // sms | email | both
  channel     String   @default("sms")
  subject     String   @default("")
  // Merge tags: {{firstName}} {{boat}} {{date}} {{time}} {{manageLink}} {{waiverLink}} {{reviewLink}} {{tipLink}} {{bookLink}}
  body        String
  // Promotional messages only go to customers who opted in
  isMarketing Boolean  @default(false)
  // Simple audience filter as JSON: {"tags":["vip"],"minTrips":1,"lastTripWithinDays":365}
  segment     String   @default("{}")
  active      Boolean  @default(true)
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sends       CampaignSend[]
}

model CampaignSend {
  id         String    @id @default(cuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookingId  String?
  booking    Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  channel    String
  // sent | failed | skipped
  status     String
  error      String?
  // Dedupe key so an automation never sends twice for the same booking/customer
  dedupeKey  String    @unique
  createdAt  DateTime  @default(now())
}

// =====================================================================
// Reputation
// =====================================================================

model Review {
  id          String   @id @default(cuid())
  // google | facebook | manual
  source      String
  externalId  String?  @unique
  author      String   @default("")
  rating      Float?
  text        String   @default("")
  url         String   @default("")
  reviewedAt  DateTime
  responded   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// Daily snapshot of the overall rating and count, for trend charts
model ReviewSnapshot {
  id        String   @id @default(cuid())
  source    String
  rating    Float
  count     Int
  takenAt   DateTime @default(now())

  @@index([source, takenAt])
}

// =====================================================================
// Accounting (expenses from Xero), costs, budgets
// =====================================================================

// Cost categories (see src/lib/constants.ts COST_CATEGORIES)
model Expense {
  id           String   @id @default(cuid())
  date         DateTime
  amountCents  Int
  category     String   @default("other")
  boatId       String?
  boat         Boat?    @relation(fields: [boatId], references: [id], onDelete: SetNull)
  vendor       String   @default("")
  description  String   @default("")
  // manual | xero | csv
  source       String   @default("manual")
  // Xero line id etc. for idempotent sync
  externalId   String?  @unique
  xeroAccountCode String?
  createdBy    String?
  createdAt    DateTime @default(now())

  @@index([date])
}

// Maps a Xero account code (and optional tracking option) to an app category / boat
model ExpenseMapping {
  id             String  @id @default(cuid())
  xeroAccountCode String
  xeroAccountName String @default("")
  category       String  @default("other")
  // When set, every expense on this account is charged to this boat
  boatId         String?
  ignore         Boolean @default(false)

  @@unique([xeroAccountCode])
}

// Single-row Xero OAuth connection (tokens encrypted at rest)
model XeroConnection {
  id            Int      @id @default(1)
  tenantId      String
  tenantName    String   @default("")
  accessToken   String
  refreshToken  String
  expiresAt     DateTime
  lastSyncAt    DateTime?
  lastSyncNote  String   @default("")
  updatedAt     DateTime @updatedAt
}

// Cost assumptions used for per-booking profitability and breakeven.
// boatId null = fleet-wide, split across boats.
model BoatCost {
  id          String  @id @default(cuid())
  boatId      String?
  boat        Boat?   @relation(fields: [boatId], references: [id], onDelete: Cascade)
  name        String
  category    String  @default("other")
  // monthly | per_trip | per_engine_hour | per_trip_hour | percent_revenue
  basis       String  @default("monthly")
  amountCents Int     @default(0)
  percentBps  Int     @default(0)
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
}

// Monthly targets. boatId null = whole business.
model Budget {
  id                 String  @id @default(cuid())
  month              String  // "2026-06"
  boatId             String?
  boat               Boat?   @relation(fields: [boatId], references: [id], onDelete: Cascade)
  revenueGoalCents   Int     @default(0)
  tripsGoal          Int     @default(0)
  expenseBudgetCents Int     @default(0)
  notes              String  @default("")

  @@unique([month, boatId])
}

// =====================================================================
// Crew: scheduling, time clock, tips
// =====================================================================

model Shift {
  id        String    @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  // dock | captain | office | cleaning
  position  String    @default("dock")
  notes     String    @default("")
  published Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@index([startsAt])
}

model TimeEntry {
  id        String    @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  clockIn   DateTime
  clockOut  DateTime?
  notes     String    @default("")
  editedBy  String?
  createdAt DateTime  @default(now())

  @@index([userId, clockIn])
}

model TimeOffRequest {
  id        String    @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate String    // YYYY-MM-DD
  endDate   String
  reason    String    @default("")
  // pending | approved | denied
  status    String    @default("pending")
  decidedBy String?
  createdAt DateTime  @default(now())
}

// Crew who worked a trip (tips are split evenly between them)
model BookingCrew {
  id        String    @id @default(cuid())
  bookingId String
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  // check_out | check_in | captain | assigned
  role      String    @default("assigned")
  createdAt DateTime  @default(now())

  @@unique([bookingId, userId])
}

model Tip {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amountCents Int
  // card | cash | mock
  method      String   @default("card")
  // booking | dock | post_trip
  source      String
  stripeId    String?
  createdBy   String?
  createdAt   DateTime @default(now())
}

// =====================================================================
// Incidents, insurance
// =====================================================================

model Incident {
  id            String    @id @default(cuid())
  bookingId     String?
  booking       Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  boatId        String?
  boat          Boat?     @relation(fields: [boatId], references: [id], onDelete: SetNull)
  // crew | guest
  reporterType  String    @default("crew")
  reporterName  String
  reporterPhone String    @default("")
  // injury | collision | grounding | property_damage | mechanical | weather | medical | lost_item | complaint | other
  type          String    @default("other")
  // low | medium | high
  severity      String    @default("low")
  occurredAt    DateTime
  location      String    @default("")
  description   String
  peopleInvolved String   @default("")
  witnesses     String    @default("")
  injuries      Boolean   @default(false)
  emsCalled     Boolean   @default(false)
  authoritiesNotified String @default("") // e.g. "USCG, TPWD game warden"
  actionsTaken  String    @default("")
  // open | investigating | closed
  status        String    @default("open")
  followUp      String    @default("")
  photos        IncidentPhoto[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model IncidentPhoto {
  id          String   @id @default(cuid())
  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  storageKey  String
  contentType String
  createdAt   DateTime @default(now())
}

model InsurancePolicy {
  id               String   @id @default(cuid())
  boatId           String
  boat             Boat     @relation(fields: [boatId], references: [id], onDelete: Cascade)
  carrier          String
  policyNumber     String   @default("")
  // e.g. "Hull & machinery + liability (charter/rental)"
  coverage         String   @default("")
  agentName        String   @default("")
  agentPhone       String   @default("")
  agentEmail       String   @default("")
  claimsPhone      String   @default("")
  hullValueCents   Int?
  liabilityLimitCents Int?
  deductibleCents  Int?
  annualPremiumCents Int?
  effectiveDate    DateTime?
  expiresAt        DateTime?
  notes            String   @default("")
  // Uploaded policy document / declarations page
  documentKey      String?
  documentType     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// =====================================================================
// Phone orders taken by Quo's AI agent (staff approve before the link is sent)
// =====================================================================

model PhoneOrder {
  id           String   @id @default(cuid())
  // Quo call id - one order per call
  callId       String   @unique
  phone        String
  customerName String   @default("")
  email        String   @default("")
  transcript   String   @default("")
  summary      String   @default("")
  // JSON from the AI: {date, startTime, boatName, rateLabel, partySize, addOns:[{name,quantity}], notes}
  extracted    String   @default("{}")
  // needs_review | approved | rejected | failed
  status       String   @default("needs_review")
  problem      String   @default("")
  bookingId    String?  @unique
  booking      Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
}
