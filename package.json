{
  "name": "porta-boat-rentals",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "setup": "prisma db push && tsx prisma/seed.ts",
    "db:demo": "tsx --conditions=react-server prisma/demo-data.ts",
    "setup:demo": "prisma db push && tsx prisma/seed.ts && tsx --conditions=react-server prisma/demo-data.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@aws-sdk/client-s3": "^3.1168.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.17",
    "next": "^15.5.29",
    "nodemailer": "^7.0.13",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "stripe": "^19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
